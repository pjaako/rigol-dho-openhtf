{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture conditions for a Rigol DHO scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timebase",
    "trigger"
  ],
  "$defs": {
    "volts": {
      "type": "string",
      "pattern": "^\\s*[-+]?\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\s*[mu\u00b5nk]?V\\s*$",
      "description": "A voltage, e.g. '-1.5 V' or '50 mV'."
    },
    "voltsPerDiv": {
      "type": "string",
      "pattern": "^\\s*[-+]?\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\s*[mu\u00b5nk]?V\\s*/\\s*div\\s*$",
      "description": "Volts per division, e.g. '1 V/div' or '50 mV/div'."
    },
    "secondsPerDiv": {
      "type": "string",
      "pattern": "^\\s*[-+]?\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\s*[mu\u00b5nk]?s\\s*/\\s*div\\s*$",
      "description": "Seconds per division, e.g. '1 ms/div' or '500 us/div'."
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale"
      ],
      "properties": {
        "scale": {
          "$ref": "#/$defs/voltsPerDiv",
          "description": "Vertical scale, volts per division, e.g. '1 V/div'."
        },
        "offset": {
          "$ref": "#/$defs/volts",
          "description": "Vertical offset, e.g. '-1.5 V'."
        },
        "coupling": {
          "enum": [
            "DC",
            "AC",
            "GND"
          ],
          "description": "Input coupling, e.g. 'DC'."
        },
        "probe": {
          "enum": [
            1,
            10,
            100
          ],
          "description": "Probe attenuation ratio, e.g. 10."
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "level"
      ],
      "properties": {
        "source": {
          "enum": [
            "ch1",
            "ch2",
            "ch3",
            "ch4"
          ],
          "description": "Trigger source channel, e.g. 'ch1'."
        },
        "level": {
          "$ref": "#/$defs/volts",
          "description": "Trigger level, e.g. '1.5 V'."
        },
        "slope": {
          "enum": [
            "rising",
            "falling",
            "either"
          ],
          "description": "Trigger edge slope, e.g. 'rising'."
        },
        "mode": {
          "enum": [
            "auto",
            "normal",
            "single"
          ],
          "description": "Trigger sweep mode, e.g. 'normal'."
        }
      }
    }
  },
  "properties": {
    "timebase": {
      "$ref": "#/$defs/secondsPerDiv",
      "description": "Horizontal sweep speed, seconds per division, e.g. '1 ms/div'."
    },
    "trigger": {
      "$ref": "#/$defs/trigger",
      "description": "Edge trigger settings, e.g. {source: ch1, level: 1.5 V}."
    },
    "ch1": {
      "$ref": "#/$defs/channel",
      "description": "Channel 1 settings; omit to leave the channel off."
    },
    "ch2": {
      "$ref": "#/$defs/channel",
      "description": "Channel 2 settings; omit to leave the channel off."
    },
    "ch3": {
      "$ref": "#/$defs/channel",
      "description": "Channel 3 settings; omit to leave the channel off."
    },
    "ch4": {
      "$ref": "#/$defs/channel",
      "description": "Channel 4 settings; omit to leave the channel off."
    },
    "memory": {
      "enum": [
        "auto",
        "1k",
        "10k",
        "100k",
        "1M",
        "10M",
        "25M"
      ],
      "description": "Acquisition memory depth: auto, 1k, 10k, 100k, 1M, 10M or 25M, e.g. '1M'."
    },
    "extra": {
      "type": "object",
      "description": "Raw SCPI header: value, for settings this model does not cover, e.g. {':CHAN1:VERN': 'ON'}."
    }
  }
}
